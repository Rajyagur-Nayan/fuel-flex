# Environment files and secrets
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
!**/.env.production

# Frontend dependencies and build output
**/node_modules/
**/.next/
**/out/
**/build/
**/dist/
*.tsbuildinfo
next-env.d.ts

# Python caches, builds, and virtual environments
**/__pycache__/
**/*.py[cod]
*$py.class
**/.venv/
**/venv/
**/ENV/
**/env/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Local databases and SQLite
**/*.db
**/*.sqlite3

# Local uploads and private data directories
data/uploads/*
!data/uploads/.gitkeep
data/employees/*
!data/employees/.gitkeep
data/attendance/*
!data/attendance/.gitkeep
**/public/uploads/*
!**/public/uploads/.gitkeep

# Logs, debug files and OS metadata
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
.vscode/
.idea/
